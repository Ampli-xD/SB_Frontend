---
// HomePage.astro
import { Image } from 'astro:assets';

const features = [
  { 
    title: "Smart Chat", 
    description: "Chat with Storm AI, your brainstorming companion. Use .b for bold and .i for italics.",
    icon: "💬"
  },
  { 
    title: "File Analysis", 
    description: "Upload documents and let Storm AI analyze them for insights.",
    icon: "📊"
  },
  { 
    title: "Intelligent Search", 
    description: "Search specific queries from your uploaded files for quick answers.",
    icon: "🔍"
  },
  { 
    title: "Productivity Boost", 
    description: "Enhance your brainstorming sessions with AI-powered assistance.",
    icon: "🚀"
  }
];
---

<div class="container mx-auto px-4 py-8">
  <div class="hud-frame relative p-8 mb-16" style="background: linear-gradient(180deg, rgba(0,178,255,0.08) 0%, rgba(0,178,255,0.02) 100%);">
    <!-- Status Indicators -->
    <div class="absolute top-4 right-4 flex space-x-2">
      <span class="w-2 h-2 rounded-full bg-[#66FF99]"></span>
      <span class="w-2 h-2 rounded-full bg-[#66CCFF]"></span>
      <span class="w-2 h-2 rounded-full bg-[#FFD966]"></span>
    </div>

    <div class="text-center relative">
      <div class="inline-block relative">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 font-['Share_Tech_Mono'] text-[#FFFFFF] animate-slideDown">
          StormBrainer_<span class="text-[#66CCFF]">AI</span>
        </h1>
        <!-- Decorative elements -->
        <div class="absolute -top-2 -left-2 w-4 h-4 border-t-2 border-l-2 border-[#66CCFF]"></div>
        <div class="absolute -bottom-2 -right-2 w-4 h-4 border-b-2 border-r-2 border-[#66CCFF]"></div>
      </div>
      
      <p class="text-xl md:text-2xl mb-8 font-['JetBrains_Mono'] text-[#8A8A8B] animate-fadeIn">
        Tactical AI-Powered Brainstorming System
      </p>
      
      <a 
        href="https://stormbrainer.vercel.app/login" 
        target="_blank" 
        class="inline-flex items-center px-8 py-4 bg-[#66CCFF] hover:bg-[#0066CC] text-[#080809] rounded font-['JetBrains_Mono'] font-semibold text-lg transition-colors animate-fadeIn relative group"
      >
        <span class="relative z-10">Initialize System</span>
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          fill="none" 
          viewBox="0 0 24 24" 
          stroke="currentColor" 
          class="w-6 h-6 ml-2 group-hover:translate-x-1 transition-transform"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Features Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    {features.map((feature, index) => (
      <div 
        class={`hud-frame p-6 backdrop-blur-lg hover:scale-105 transition-all animate-fadeInUp`}
        style={{
          background: "linear-gradient(180deg, rgba(0,178,255,0.04) 0%, rgba(0,178,255,0.01) 100%)",
          border: "2px solid rgba(255,255,255,0.15)",
          animationDelay: `${index * 150}ms`
        }}
      >
        <div class="flex items-start space-x-3">
          <span class="text-2xl">{feature.icon}</span>
          <div>
            <h3 class="text-xl font-['Share_Tech_Mono'] text-[#66CCFF] mb-2">{feature.title}</h3>
            <p class="font-['JetBrains_Mono'] text-[#8A8A8B] text-sm">{feature.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  @keyframes slideDown {
    from { transform: translateY(-50px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fadeInUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .animate-slideDown {
    animation: slideDown 0.8s ease-out forwards;
  }

  .animate-fadeIn {
    animation: fadeIn 1s ease-out forwards;
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .hud-frame {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
  }

  .hud-frame::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, 
      rgba(102, 204, 255, 0) 0%,
      rgba(102, 204, 255, 0.5) 50%,
      rgba(102, 204, 255, 0) 100%
    );
  }
</style>