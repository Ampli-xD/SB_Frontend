---
// HomePage.astro
import { Image } from 'astro:assets';

const features = [
  { title: "Smart Chat", description: "Chat with Storm AI, your brainstorming companion" },
  { title: "File Analysis", description: "Upload documents and let Storm AI analyze them" },
  { title: "Intelligent Search", description: "Search specific queries from your uploaded files" },
  { title: "Productivity Boost", description: "Enhance your brainstorming with AI assistance" }
];
---

<div class="container mx-auto px-4 py-16">
  <div class="text-center mb-16">
    <h1 class="text-4xl md:text-6xl font-bold mb-6">Welcome to StormBrainer</h1>
    <p class="text-xl md:text-2xl mb-8">Your AI-Powered Brainstorming Assistant</p>
    <a 
      href="/chat" 
      class="bg-blue-600 text-white px-8 py-4 rounded-lg font-semibold text-lg inline-flex items-center hover:bg-blue-700 transition-colors"
    >
      Get Started
      <svg 
        xmlns="http://www.w3.org/2000/svg" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        class="w-6 h-6 ml-2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    {features.map(feature => (
      <div class="bg-white p-6 rounded-lg shadow-lg">
        <h3 class="text-xl font-semibold mb-2">{feature.title}</h3>
        <p class="text-gray-600">{feature.description}</p>
      </div>
    ))}
  </div>
</div>